# --- Secrets ---
.env
.env.local

# --- Local configuration and run history ---
# The tracked template is gas-optimizer.example.toml.
gas-optimizer.toml
runs/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Foundry ---
foundry/out/
foundry/cache/
foundry/snapshots/
# src/ and test/ are scratch: originals, candidates and the equivalence
# harness are all regenerated on every run. Inputs live in test-cases/,
# fixtures in tests/fixtures/.
foundry/src/*
!foundry/src/.gitkeep
foundry/test/*
!foundry/test/.gitkeep
foundry/broadcast/*/31337/
foundry/broadcast/**/dry-run/
docs/book/

# Compiled bytecode dumps produced by the hevm equivalence check
*.bin

# --- Editor / OS ---
.DS_Store
.vscode/
.idea/
