# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Hugging Face Inference API token — https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model used for optimization proposals (optional, has a default)
MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct

# Inference provider. Leave empty to let huggingface_hub choose.
HF_PROVIDER=

# Attempts at the optimize-and-verify loop before giving up.
MAX_RETRIES=5

# Attempts at a single API call before giving up on it.
API_RETRIES=3
